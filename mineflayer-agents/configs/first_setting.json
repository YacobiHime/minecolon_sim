    { "name": "Ken", "personality": "陽気で話し好き。段取りを仕切りたがる。", "speech": "元気なくだけた話し方。",
      "temperament": { "bravery": 0.6, "empathy": 0.5, "obedience": 0.4, "greed": 0.4, "sociability": 0.9 } }
  ],
  "goal": {
    "text": "仲間と協力して、夜までに拠点(小屋)を作り、食べ物を確保する。",
    "hints": [
      "原木1個から板材(_planks)が4個作れる。",
      "小屋は拠点で build を選ぶと、決まった形(5x5、壁の高さ2、屋根つき)に数個ずつ置かれる。板材・原木・丸石・土で建てられ、全部で55個くらい要る。",
      "牛・豚・羊・鶏を hunt すると肉が手に入る。肉は食べ物になる。",
      "夜は日が沈むと始まる。一人でやるより手分けしたほうが早い。"
    ],
    "steps": [
      { "text": "collect で原木(_log)を集める", "doneWhen": [{ "inventory": { "_log$": 4 } }, { "inventory": { "_planks$": 12 } }, { "hut": 0.9 }] },
      { "text": "craft で板材(_planks)を作る", "doneWhen": [{ "inventory": { "_planks$": 8 } }, { "hut": 0.9 }] },
      { "text": "拠点で build して小屋を建てる", "doneWhen": [{ "hut": 0.9 }] },
      { "text": "hunt で食べ物(肉)を2個手に入れる", "doneWhen": [{ "food": 2 }] }
    ],
    "success": { "hut": 0.9, "food": 2 }
  },
  "world": {
    "base": "spawn",
    "baseOffset": { "x": 0, "z": 6 },
    "hut": { "size": 5, "height": 2, "roof": true, "door": "south" }
  },
  "help": { "hints": true, "steps": true, "progress": true, "askOthers": true, "excludeFailures": false },
  "decider": { "type": "jev", "jev": { "model": "jev-latest", "maxConcurrent": 8, "timeoutMs": 15000 }, "llm": { "think": true } },
  "talk": { "threshold": 0.6, "llm": { "maxTokens": 64, "temperature": 0.7 } },
  "ask": { "waitMs": 45000, "cooldown": 10, "useWindow": 6 },
  "usage": { "maxJevInputTokens": 3000000 },
  "memory": { "perRun": true, "limits": { "promptItems": 20, "promptPlaces": 6, "halfLife": 40, "impBoost": 6, "forgetBelow": 0.08 } },
  "perception": { "visionRadius": 16, "hearRadius": 24 },
  "act": { "buildPerAction": 4 },
  "loop": { "minutes": 15, "failWindow": 4, "failRepeat": 2 }
