    { "name": "Hanako", "personality": "世話好きで、人に教えるのが好き。", "speech": "やわらかい丁寧語。",
      "temperament": { "bravery": 0.4, "empathy": 0.9, "obedience": 0.5, "greed": 0.2, "sociability": 0.8 } },
    { "name": "Jiro", "personality": "せっかちで負けず嫌い。自分でやりたがる。", "speech": "ぶっきらぼうで短い。",
      "temperament": { "bravery": 0.8, "empathy": 0.3, "obedience": 0.3, "greed": 0.6, "sociability": 0.3 } },
    { "name": "Yuki", "personality": "慎重で怖がり。夜が苦手。", "speech": "控えめで、ときどき言いよどむ。",
